rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function callerUser() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(p) ? get(p).data : {};
    }

    function callerRole() {
      return signedIn() ? callerUser().role : '';
    }

    function isAdmin() {
      return signedIn() && callerRole() == 'admin';
    }

    function isDriver() {
      return signedIn() && callerRole() == 'driver';
    }

    function isStaffAdminUser() {
      let d = callerUser();
      return isAdmin() && (!('staffRole' in d) || d.staffRole == 'admin');
    }

    function hasGrantFields() {
      let d = callerUser();
      return 'canAccessAllBranches' in d || 'branchIds' in d;
    }

    function canAccessBranch(branchId) {
      let d = callerUser();
      return isAdmin() && (
        !hasGrantFields()
        || d.canAccessAllBranches == true
        || (d.branchIds is list && branchId in d.branchIds)
      );
    }

    function grantFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['staffRole', 'branchIds', 'canAccessAllBranches']);
    }

    function driverIdEmpty(data) {
      return !('driverID' in data)
        || data.driverID == null
        || data.driverID == '';
    }

    function customerDriverSwap() {
      let before = resource.data.role;
      let after = request.resource.data.role;
      return (before == 'customer' && after == 'driver')
        || (before == 'driver' && after == 'customer');
    }

    function validUsersCreatePayload(userId) {
      return request.resource.data.id == userId
        && request.resource.data.role in ['customer', 'driver']
        && request.resource.data.email is string
        && request.resource.data.profile is map
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        isSelf(userId) || isAdmin()
        || resource.data.role == 'driver'
      );
      allow create: if (isSelf(userId) && validUsersCreatePayload(userId))
        || (isAdmin()
          && validUsersCreatePayload(userId)
          && request.resource.data.role == 'driver');
      allow update: if (
          isStaffAdminUser()
          && request.resource.data.role == resource.data.role
          && (userId != request.auth.uid
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['staffRole']))
        )
        || (
          isAdmin()
          && !grantFieldsChanged()
          && request.resource.data.role == resource.data.role
        )
        || (
          isSelf(userId)
          && request.resource.data.role == resource.data.role
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['corporateAccountId', 'staffRole', 'branchIds', 'canAccessAllBranches'])
        )
        || (
          isSelf(userId)
          && customerDriverSwap()
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['corporateAccountId', 'staffRole', 'branchIds', 'canAccessAllBranches'])
        );
      allow delete: if isStaffAdminUser();

      match /payment_methods/{paymentMethodId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }
    }

    match /app_settings/{docId} {
      allow read: if docId in ['license', 'plans', 'workspace', 'company']
        || (signedIn() && isAdmin() && docId == 'integrations');
      allow write: if isAdmin() && docId in ['license', 'plans', 'workspace', 'integrations', 'company'];
    }

    function validNotificationCategories() {
      return [
        'driver', 'vehicle', 'profile', 'company', 'location',
        'operating_hours', 'locale', 'pricing', 'invoice', 'admin'
      ];
    }

    function validNotificationActions() {
      return ['created', 'updated', 'deleted'];
    }

    // Activity feed remains company-wide (not branch-scoped).
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.category in validNotificationCategories()
        && request.resource.data.action in validNotificationActions()
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /corporateAccounts/{accountId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Branch sub-accounts: nested ops data under branches/{branchId}/…
    match /branches/{branchId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if canAccessBranch(branchId);

      match /settings/{docId} {
        allow read: if signedIn();
        allow write: if canAccessBranch(branchId);
      }

      match /trips/{tripId} {
        function isCustomerOfTrip() {
          return resource.data.customerID == request.auth.uid;
        }
        function isDriverOfTrip() {
          return resource.data.driverID == request.auth.uid;
        }
        function isOpenRequest() {
          return resource.data.status == 'requested' && driverIdEmpty(resource.data);
        }

        allow read: if signedIn() && (
          canAccessBranch(branchId)
          || isCustomerOfTrip()
          || isDriverOfTrip()
          || (isDriver() && isOpenRequest())
        );
        allow create: if signedIn() && (!isAdmin() || canAccessBranch(branchId));
        allow update: if signedIn() && (
          canAccessBranch(branchId)
          || isCustomerOfTrip()
          || isDriverOfTrip()
          || (isDriver() && isOpenRequest())
        );
        allow delete: if canAccessBranch(branchId);
      }

      match /vehicle_classes/{classId} {
        allow read: if true;
        allow write: if canAccessBranch(branchId);
      }

      match /vehicles/{vehicleId} {
        allow read: if signedIn();
        allow create, update, delete: if canAccessBranch(branchId)
          || (signedIn() && request.auth.uid == vehicleId);
      }

      match /locations/{locId} {
        allow read: if signedIn();
        allow create, update, delete: if canAccessBranch(branchId);
      }

      match /invoices/{invoiceId} {
        allow read: if canAccessBranch(branchId)
          || (signedIn() && resource.data.customerID == request.auth.uid);
        allow write: if canAccessBranch(branchId);
      }

      match /drivers/{driverUid} {
        allow read: if signedIn();
        allow write: if canAccessBranch(branchId) || isSelf(driverUid);
      }
    }

    // Collection-group reads of `trips` (customer Upcoming across every Location).
    match /{path=**}/trips/{tripId} {
      allow read: if signedIn()
        && resource.data.customerID is string
        && resource.data.customerID == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
